# =====================================================================
# Medication Platform — قالب الإعدادات
#
# لا تنسخ هذا الملف يدويًا. نفّذ:
#     python scripts/setup.py
# فيُنشئ .env بكلمات مرور وأسرار عشوائية. كل قيمة CHANGE_ME هنا تُستبدل.
# ملف .env نفسه مستبعد من Git (BR-025).
#
# هنا فقط ما قد تحتاج تغييره. باقي الإعدادات (حدود المحاولات، مدد الجلسات،
# مواعيد المهام الدورية، أسماء القواعد وحساباتها…) قيمها ثابتة في الكود، وتُغيَّر
# بإضافة السطر إلى .env. قائمتها في docs/RUNNING.md («إعدادات اختيارية»).
# بعد تعديل .env: python scripts/dev.py restart
# =====================================================================

APP_ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# أسرار مشتركة (تُولَّد عشوائيًا)
# ---------------------------------------------------------------------
# يحمي مسارات /internal/v1 بين الخدمات. 32 حرفًا على الأقل.
INTERNAL_API_TOKEN=CHANGE_ME
# مفتاح تجزئة حدود محاولات الدخول (لا يُخزَّن بريد ولا IP كنص). 32 حرفًا على الأقل.
RATE_LIMIT_PEPPER=CHANGE_ME

# ---------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------
# كلمة مرور root، يستعملها setup.py وحده للتجهيز. فارغة = يسألك عنها.
MYSQL_ADMIN_PASSWORD=

# حساب لكل خدمة (svc_<الخدمة>) على قاعدتها (<الخدمة>_db) فقط، بلا صلاحية تعديل الجداول (BR-028).
# كلمة مرور واحدة تعرفها لها كلها: python scripts/setup.py --db-password القيمة
AUTH_DB_PASSWORD=CHANGE_ME
PATIENT_DB_PASSWORD=CHANGE_ME
PHARMACY_DB_PASSWORD=CHANGE_ME
MEDICATION_DB_PASSWORD=CHANGE_ME
INVENTORY_DB_PASSWORD=CHANGE_ME
ORDER_DB_PASSWORD=CHANGE_ME
HEALTH_DB_PASSWORD=CHANGE_ME
AI_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------
# منافذ الخدمات — تقرؤها الخدمات و dev.py وبوابة الواجهة. عنوان كل خدمة يُشتق من منفذها.
# لتغييرها كلها معًا: python scripts/setup.py --port-base 5101   (5101 … 5109)
# ---------------------------------------------------------------------
AUTH_SERVICE_PORT=5001
PATIENT_SERVICE_PORT=5002
PHARMACY_SERVICE_PORT=5003
MEDICATION_SERVICE_PORT=5004
INVENTORY_SERVICE_PORT=5005
ORDER_SERVICE_PORT=5006
HEALTH_SERVICE_PORT=5007
AI_SERVICE_PORT=5008
NOTIFICATION_SERVICE_PORT=5009

RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F

# ---------------------------------------------------------------------
# المنصة
# ---------------------------------------------------------------------
# عملة الأسعار (رمز ISO): SYP = الليرة السورية.
INVENTORY_CURRENCY=SYP
# المنطقة الزمنية الافتراضية لجداول الجرعات.
HEALTH_DEFAULT_TIMEZONE=Asia/Amman

# ---------------------------------------------------------------------
# النموذج اللغوي على جهازك لملخص الالتزام [خارجي]
# ---------------------------------------------------------------------
# Ollama ومعه: ollama pull qwen2.5:3b. عنوان فارغ = بلا نموذج (القالب الثابت دائمًا).
# حالته في: python scripts/dev.py status
AI_LLM_URL=http://127.0.0.1:11434
AI_LLM_MODEL=qwen2.5:3b
# أقصى انتظار بالثواني؛ بعدها يُكتب الملخص بالقالب الثابت.
AI_LLM_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------
# مسافة الطريق في الواجهة [خارجي]
# ---------------------------------------------------------------------
# خدمة OSRM العامة (على خرائط OpenStreetMap): ترى إحداثيات المريض والصيدلية.
# قيمة فارغة = مسافة الخط المستقيم.
ROUTING_URL=https://router.project-osrm.org
